generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VoiceEntryStatus {
  RECORDING
  TRANSCRIBING
  EXTRACTING
  PENDING_APPROVAL
  AWAITING_CLARIFICATION
  APPROVED
  SYNCED
  FAILED
  CANCELED
}

enum Plan {
  FREE
  PRO
  SCALE
}

enum UsageType {
  ENTRIES_CREATED
  AUDIO_SECONDS
}

enum EntrySource {
  WEB
  TELEGRAM
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  avatarUrl          String?
  companyName        String?
  companyCode        String?  @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  notionConnection     NotionConnection?
  notionDatabaseConfig NotionDatabaseConfig?
  employees            Employee[]
  voiceEntries         VoiceEntry[]
  stripeCustomer       StripeCustomer?
  usageEvents          UsageEvent[]
}

model NotionConnection {
  id                   String    @id @default(uuid())
  userId               String    @unique
  workspaceId          String?
  workspaceName        String?
  workspaceIcon        String?
  accessTokenEncrypted String
  botId                String?
  connectedAt          DateTime  @default(now())
  revokedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionDatabaseConfig {
  id                 String   @id @default(uuid())
  userId             String   @unique
  databaseId         String
  databaseName       String
  schemaSnapshotJson Json
  mappingJson        Json
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Employee {
  id             String   @id @default(uuid())
  adminId        String
  employeeCode   String
  name           String
  telegramChatId String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin        User         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  voiceEntries VoiceEntry[]

  @@unique([adminId, employeeCode])
}

model VoiceEntry {
  id                String           @id @default(uuid())
  userId            String
  employeeId        String?
  source            EntrySource      @default(TELEGRAM)
  databaseId        String
  telegramMessageId String?          @unique
  telegramChatId    String?
  audioStoragePath  String?
  audioDurationSecs Float?
  transcriptText    String?
  extractedJson     Json?
  finalJson         Json?
  warningsJson      Json?
  status            VoiceEntryStatus @default(RECORDING)
  notionPageId      String?
  notionPageUrl     String?
  meetingType       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])
}

model StripeCustomer {
  id                   String   @id @default(uuid())
  userId               String   @unique
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?
  plan                 Plan     @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String    @id @default(uuid())
  userId    String
  type      UsageType
  quantity  Float
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}
